{
  "name": "selah-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "devotion:generate": "node scripts/generate-daily-devotion.js",
    "devotion:dry-run": "node scripts/generate-daily-devotion.js --dry-run",
    "devotion:local": "sh scripts/selah/cron.sh",
    "devotion:test": "node --test scripts/selah/*.test.js",
    "bible:test": "node --test scripts/bible/*.test.js",
    "background:generate": "node scripts/generate-daily-background.js",
    "background:dry-run": "node scripts/generate-daily-background.js --dry-run",
    "background:test": "node --test scripts/selah/background.test.js",
    "card:test": "node --test src/lib/*.test.js",
    "firebase:setup": "node scripts/setup-firebase-storage.js",
    "firebase:check": "node scripts/setup-firebase-storage.js --check",
    "background:upload": "node scripts/upload-background.js",
    "check:cache": "node scripts/check-deploy-cache.js"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.19.16",
    "@supabase/supabase-js": "^2.109.0",
    "firebase": "^11.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "firebase-admin": "^14.4.0",
    "postcss": "^8.4.49",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
