# Local SELAH devotion generator secrets. Copy to .env.local (gitignored).
#
# The generator runs the SELAH agent brief through the OpenCode bridge, which
# lets it genuinely research Scripture and the trusted teachers named in the
# brief, then writes ONE daily_devotions row for the date with the service-role
# key. Every user reads that same row — the browser never talks to the bridge.
#
# Prerequisites, both on this machine:
#   opencode serve --port 4097
#   cd backend/bridge/opencode-bridge && npm start     # bridge on 4098

# service_role is in Supabase > Project Settings > API. Never ship it to the
# browser — only this script uses it.
SUPABASE_URL=https://icmjnqwffvlacakwtpjb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Optional. Defaults shown.
# BRIDGE_URL=http://127.0.0.1:4098
#
# big-pickle is the default because it is NOT billed against the OpenCode
# workspace monthly spending limit. Once that cap is reached, every other
# opencode/* model returns an empty reply rather than an error.
#   big-pickle         ~150-220s, researches properly, ~680-700 word reflection
#   claude-sonnet-4-6  faster and slightly richer, but billed against the cap
# BRIDGE_MODEL=opencode/big-pickle

# ---------------------------------------------------------------------------
# Daily background (scripts/fetch-daily-background.js, upload-background.js,
# generate-daily-background.js)
# ---------------------------------------------------------------------------
#
# ONE background image a day for the Scripture-sharing verse cards, normally a
# freely-licensed stock photo matched to the day's devotion. The image goes to
# Firebase Storage; only its metadata goes to Supabase. The browser needs
# neither of these — it reads the public URL from the daily_backgrounds table.
# See README > Verse sharing with daily backgrounds.

# A Firebase service account key:
#   Firebase console > Project settings > Service accounts > Generate new
#   private key.
#
# Three forms are accepted. LOCALLY, just point at the downloaded file — no
# encoding step, and the key stays out of the repo directory:
#     FIREBASE_SERVICE_ACCOUNT=/Users/you/.config/selah/firebase-sa.json
#
# IN GITHUB ACTIONS, use base64 — a GitHub secret and a .env parser both mangle
# the newlines inside the private key, which surfaces much later as an
# unreadable OpenSSL PEM error:
#     base64 -i firebase-sa.json | pbcopy
#   (-i is required on macOS; without it base64 reports "invalid argument",
#    and a glob matching TWO files silently eats the -i.)
#
# NEVER commit this, and never expose it to the browser — it can read and
# write every bucket in the project.
FIREBASE_SERVICE_ACCOUNT=/absolute/path/to/firebase-sa.json

# Firebase console > Storage. Note the bucket host, not the project id.
FIREBASE_STORAGE_BUCKET=devotional-app-c2633.firebasestorage.app

# Optional. Stock photo search for scripts/fetch-daily-background.js
# (pixabay.com/api/docs). Without it the script searches Openverse, which needs no key.
# PIXABAY_API_KEY=

# Optional, for scripts/generate-daily-background.js. Nano Banana 2 is the default.
#   google/gemini-3.1-flash-image       Nano Banana 2      (default)
#   google/gemini-3-pro-image           Nano Banana Pro    (slower, pricier)
#   google/gemini-3.1-flash-lite-image  Nano Banana 2 Lite (cheapest)
# BACKGROUND_MODEL=google/gemini-3.1-flash-image

# ---------------------------------------------------------------------------
# Bible reader "Explain" (src/components/ExplainSheet.jsx)
# ---------------------------------------------------------------------------
#
# Browser-side: Vite inlines VITE_* at build time, so set it in .env (or the
# deploy environment) before `npm run build`. It is a public, auth-free embed
# endpoint. Leave it unset to hide the Explain option.
# VITE_ZACKION_CHAT_URL=https://www.zackion-ai.com/api/chat/2c02a09f-82fa-4044-8b61-6b67b2bd44ae

# ---------------------------------------------------------------------------
# Bible reader "Listen" (supabase/functions/bible-tts, src/components/ListenPlayer.jsx)
# ---------------------------------------------------------------------------
#
# NOT read from this file. These are Supabase Edge Function secrets — there is
# deliberately no VITE_ variant, because anything VITE_* ships in the bundle.
# Set them from your own shell:
#   supabase secrets set ELEVENLABS_API_KEY=<your key> GEMINI_API_KEY=<your key>
# (either alone works: ElevenLabs is the default voice, Gemini the fallback)
#
# Optional, defaults shown:
#   ELEVENLABS_MODEL=eleven_flash_v2_5   (or eleven_turbo_v2_5, eleven_multilingual_v2)
#   ELEVENLABS_VOICE_IDS=                (e.g. George=<voice id>,Sarah=<voice id> to correct an id)
#   GEMINI_TTS_MODELS=gemini-3.8-flash-preview-tts,gemini-3.1-flash-preview-tts,gemini-2.5-flash-preview-tts,gemini-3.8-flash-lite-preview-tts
#                              (tried in order; confirm the ids in AI Studio, unknown ids are skipped;
#                               GEMINI_TTS_MODEL=<one id> still works when this is unset)
#   TTS_RATE_LIMIT=6         (generated chapters per user per minute; cache hits are free)
# Voices and reading styles are chosen in the app from the allow-list in
# supabase/functions/_shared/ttsConfig.js.
