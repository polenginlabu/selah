# Local SELAH devotion generator secrets. Copy to .env.local (gitignored).
#
# The generator runs the SELAH agent brief through the OpenCode bridge, which
# lets it genuinely research Scripture and the trusted teachers named in the
# brief, then writes ONE daily_devotions row for the date with the service-role
# key. Every user reads that same row — the browser never talks to the bridge.
#
# Prerequisites, both on this machine:
#   opencode serve --port 4097
#   cd backend/bridge/opencode-bridge && npm start     # bridge on 4098

# service_role is in Supabase > Project Settings > API. Never ship it to the
# browser — only this script uses it.
SUPABASE_URL=https://icmjnqwffvlacakwtpjb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Optional. Defaults shown.
# BRIDGE_URL=http://127.0.0.1:4098
#
# big-pickle is the default because it is NOT billed against the OpenCode
# workspace monthly spending limit. Once that cap is reached, every other
# opencode/* model returns an empty reply rather than an error.
#   big-pickle         ~150-220s, researches properly, ~680-700 word reflection
#   claude-sonnet-4-6  faster and slightly richer, but billed against the cap
# BRIDGE_MODEL=opencode/big-pickle

# ---------------------------------------------------------------------------
# Daily background generation (scripts/generate-daily-background.js)
# ---------------------------------------------------------------------------
#
# Generates ONE background image a day for the Scripture-sharing verse cards.
# The image goes to Firebase Storage; only its metadata goes to Supabase. The
# browser needs neither of these — it reads the public URL from the
# daily_backgrounds table. See README > Daily background generation.

# A Firebase service account key with the "Storage Object Admin" role:
#   Firebase console > Project settings > Service accounts > Generate new
#   private key. Raw JSON works, but base64 avoids every newline and quoting
#   problem in .env files and GitHub secrets:
#     base64 -i service-account.json | pbcopy
# NEVER commit this, and never expose it to the browser — it can read and
# write every bucket in the project.
FIREBASE_SERVICE_ACCOUNT=replace-with-base64-or-raw-service-account-json

# Firebase console > Storage. Note the bucket host, not the project id.
FIREBASE_STORAGE_BUCKET=devotional-app-c2633.firebasestorage.app

# Optional. Nano Banana 2 is the default.
#   google/gemini-3.1-flash-image       Nano Banana 2      (default)
#   google/gemini-3-pro-image           Nano Banana Pro    (slower, pricier)
#   google/gemini-3.1-flash-lite-image  Nano Banana 2 Lite (cheapest)
# BACKGROUND_MODEL=google/gemini-3.1-flash-image
