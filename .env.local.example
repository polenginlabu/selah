# Local SELAH devotion generator secrets. Copy to .env.local (gitignored).
#
# The generator runs the SELAH agent brief through the OpenCode bridge, which
# lets it genuinely research Scripture and the trusted teachers named in the
# brief, then writes ONE daily_devotions row for the date with the service-role
# key. Every user reads that same row — the browser never talks to the bridge.
#
# Prerequisites, both on this machine:
#   opencode serve --port 4097
#   cd backend/bridge/opencode-bridge && npm start     # bridge on 4098

# service_role is in Supabase > Project Settings > API. Never ship it to the
# browser — only this script uses it.
SUPABASE_URL=https://icmjnqwffvlacakwtpjb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Optional. Defaults shown.
# BRIDGE_URL=http://127.0.0.1:4098
#
# big-pickle is the default because it is NOT billed against the OpenCode
# workspace monthly spending limit. Once that cap is reached, every other
# opencode/* model returns an empty reply rather than an error.
#   big-pickle         ~150-220s, researches properly, ~680-700 word reflection
#   claude-sonnet-4-6  faster and slightly richer, but billed against the cap
# BRIDGE_MODEL=opencode/big-pickle
