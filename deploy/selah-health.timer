# Runs the health check every 5 minutes.
#
#   sudo systemctl enable --now selah-health.timer
#   systemctl list-timers selah-health.timer
[Unit]
Description=Run the SELAH bridge health check periodically

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
# Spread the check off the exact minute so it never collides with the 03:00
# devotion run starting the services itself.
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
